-- | Test tokens for the Sup demo.
--
-- A holding is signed by its issuer and observed by its owner: the owner
-- controls movement, but only the issuer's authority can bring units into
-- existence. That is what lets settlement re-issue both legs atomically.
module Sup.Assets where

import DA.Action (when)
import DA.TextMap qualified as TextMap
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

template AssetToken
  with
    issuer : Party
    owner : Party
    assetClass : Text
    quantity : Decimal
    metadataHash : Text
  where
    signatory issuer
    observer owner
    ensure quantity > 0.0

    -- Canton Token Standard (CIP-56): any standard wallet or explorer can read this
    -- as a Holding of instrument <issuer>/<assetClass>.
    interface instance Holding for AssetToken where
      view = HoldingView with
        owner
        instrumentId = InstrumentId with admin = issuer, id = assetClass
        amount = quantity
        lock = None
        meta = Metadata with values = TextMap.fromList [("sup.metadataHash", metadataHash)]

    choice AssetToken_Transfer : ContractId AssetToken
      with newOwner : Party
      controller owner
      do create this with owner = newOwner

    choice AssetToken_Split : (ContractId AssetToken, ContractId AssetToken)
      with splitQuantity : Decimal
      controller owner
      do
        assertMsg "invalid split" (splitQuantity > 0.0 && splitQuantity < quantity)
        a <- create this with quantity = splitQuantity
        b <- create this with quantity = quantity - splitQuantity
        pure (a, b)

    choice AssetToken_Merge : ContractId AssetToken
      with otherCid : ContractId AssetToken
      controller owner
      do
        other <- fetch otherCid
        assertMsg "cannot merge different holdings"
          (other.owner == owner && other.issuer == issuer && other.assetClass == assetClass)
        archive otherCid
        create this with quantity = quantity + other.quantity

template CashToken
  with
    issuer : Party
    owner : Party
    currency : Text
    amount : Decimal
  where
    signatory issuer
    observer owner
    ensure amount > 0.0

    interface instance Holding for CashToken where
      view = HoldingView with
        owner
        instrumentId = InstrumentId with admin = issuer, id = currency
        amount
        lock = None
        meta = emptyMetadata

    choice CashToken_Transfer : ContractId CashToken
      with newOwner : Party
      controller owner
      do create this with owner = newOwner

    choice CashToken_Split : (ContractId CashToken, ContractId CashToken)
      with splitAmount : Decimal
      controller owner
      do
        assertMsg "invalid split" (splitAmount > 0.0 && splitAmount < amount)
        a <- create this with amount = splitAmount
        b <- create this with amount = amount - splitAmount
        pure (a, b)

    choice CashToken_Merge : ContractId CashToken
      with otherCid : ContractId CashToken
      controller owner
      do
        other <- fetch otherCid
        assertMsg "cannot merge different holdings"
          (other.owner == owner && other.issuer == issuer && other.currency == currency)
        archive otherCid
        create this with amount = amount + other.amount

-- Keep `when` in scope for downstream modules importing Assets.
_unusedWhen : Bool -> Update () -> Update ()
_unusedWhen = when
