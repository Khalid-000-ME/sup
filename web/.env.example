# Sup runs against the shared HackCanton participant on Canton DevNet.
# Copy this file to .env.local and fill in your HackCanton platform login.
# .env.local is gitignored. Never commit these values.

SUP_NETWORK=devnet
OIDC_USERNAME=you@example.com
OIDC_PASSWORD=
# Alternatively use a long-lived refresh token instead of the password:
# OIDC_REFRESH_TOKEN=

# Party names created in the node Console are <SUP_PARTY_BASE>-seller, -buyer, ... (default: sup)
# SUP_PARTY_BASE=sup

# Public deployments: require this code for every action that changes the ledger.
# Leave unset locally.
# SUP_ACCESS_CODE=choose-a-code

# Hosts whose disk is wiped on restart: point this at a mounted volume to keep off-ledger data.
# SUP_DATA_DIR=/var/data

# Optional overrides (sane defaults are built in):
# LEDGER_URL=
# OIDC_TOKEN_URL=
# OIDC_CLIENT_ID=
# UTILITIES_API=
# CBTC_ADMIN=
# CETH_ADMIN=
